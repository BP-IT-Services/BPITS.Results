<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>

        <PackageId>BPITS.Results.AspNetCore</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>ASP.NET Core extensions for BPITS.Results that let ApiResult be returned from controllers (IActionResult) and Minimal API endpoints (IResult) with automatic HTTP status code mapping.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- Generators load inside the consumer's compiler, so this pin sets the oldest SDK that can run them
             (4.8 = .NET 8 SDK / VS 17.8). Raising it silently disables generation for consumers on older
             compilers (CS9057), which is what broke 2.0.2 for .NET 8 users. Do not bump without that in mind. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BPITS.Results.AspNetCore.Abstractions\BPITS.Results.AspNetCore.Abstractions.csproj" />
        <ProjectReference Include="..\BPITS.Results\BPITS.Results.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    </ItemGroup>
</Project>