<Project>
  <PropertyGroup>
    <!-- Shared package metadata.
         Release builds override Version from the vX.Y.Z release tag; keeping it at the upcoming release
         means local packs and project references carry the right number. -->
    <Version>2.1.0</Version>
    <Authors>BytePerfect IT Services</Authors>
    <RepositoryUrl>https://github.com/BP-IT-Services/BPITS.Results</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>result-pattern</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Common compiler settings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>
</Project>